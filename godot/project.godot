; Engine configuration file.
config_version=5

[application]

config/name="The Neon Defense"
config/description="Neon tower defense — Godot edition at parity with the JS reference."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

State="*res://scripts/game_state.gd"
AudioEngine="*res://scripts/audio_engine.gd"
Tech="*res://scripts/tech_tree.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Match the JS/Flutter near-black background (C.COL_BG "050510") instead of
; Godot's default gray clear color.
environment/defaults/default_clear_color=Color(0.0196078, 0.0196078, 0.0627451, 1)

[input_devices]

# Touch taps emulate mouse so GUI buttons work on mobile/web; the reverse
# (mouse->touch) is left off — with both on, a single tap produced duplicate
# events that could leak past a button to the world tap handler.
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
